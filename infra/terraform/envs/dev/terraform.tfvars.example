# Optional overrides. The Makefile already passes project, region, zone, cluster name and billing
# account from .env as TF_VAR_*; values here take precedence. terraform.tfvars is gitignored.

# cpu_machine_type   = "e2-standard-4"
# gpu_machine_type   = "g2-standard-8"
# gpu_type           = "nvidia-l4"
# gpu_driver_version = "LATEST"                              # or "DEFAULT"
# gpu_zones          = ["us-central1-a", "us-central1-b"]    # more zones = more Spot capacity
# gpu_pool_max_nodes = 1
# budget_usd         = 90
