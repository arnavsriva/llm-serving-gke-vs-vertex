# Copy to .env and fill in. Never commit .env.

# --- GCP ---
GCP_PROJECT_ID=your-project-id
GCP_REGION=us-central1
GCP_ZONE=us-central1-a
TF_STATE_BUCKET=your-tf-state-bucket

# --- GKE ---
GKE_CLUSTER_NAME=llm-serving-dev
K8S_NAMESPACE=inference

# --- Artifact Registry ---
AR_REPO=llm-serving

# --- Model ---
MODEL_ID=Qwen/Qwen3-8B-AWQ
FINETUNE_BASE_MODEL=Qwen/Qwen3-1.7B
# Only needed if a model/dataset is gated. Prefer Secret Manager in-cluster.
HF_TOKEN=

# --- Vertex AI ---
VERTEX_ENDPOINT_NAME=qwen3-8b-vllm
VERTEX_MACHINE_TYPE=g2-standard-8

# --- Benchmark ---
# Base URL of the OpenAI-compatible server under test (port-forward, LB, or Vertex predict URL).
BENCH_BASE_URL=http://localhost:8000
BENCH_TARGET=vllm-gke

# --- Cost table: hourly prices you have confirmed (USD). Leave blank until confirmed. ---
PRICE_G2_STANDARD_8_SPOT_PER_HOUR=
PRICE_VERTEX_G2_STANDARD_8_PER_HOUR=
PRICE_SOURCE_DATE=
